/mycmd/setDetLength 27.0 mm
/mycmd/setDetRadius 28.5 mm
/mycmd/setHoleRadius 6.0 mm
/mycmd/setHoleLength 21.0 mm
/mycmd/update
/run/initialize
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+3 year
/process/activate RadioactiveDecay
/gps/particle ion
/gps/ion 63 152 0 0
/gps/energy 0. keV
/gps/pos/type Point
/gps/pos/centre -1.3 0.0 8.5 cm
/gps/pos/confine physPlastic
/gps/ang/type iso
/run/beamOn 1000000
